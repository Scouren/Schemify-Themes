# Schemify-Themes template: Schemify's Modern preset with each colour named by its role (an at-sign token).
# tools/spicetify.py fills the tokens per scheme from themes/palettes.tsv; the plugin does the same at run time.


style *
  fg @text
  accel-fg @muted
  hover-bg @hover
  active-bg @active
  border-color @border

style window
  bg @bg

style menubar
  bg @panel
  height 26
  pad 9
  gap 0

style menu-title
  pad 7
  hover-bg @hover
  active-bg @active

style menubar-dash
  fg @dim2

style menubar-button
  bg @panel
  hover-bg @hover
  pad 4

style menu
  bg @raised
  border-color @border

style item
  hover-bg @active

style separator
  fg @border

style toolbar
  bg @panel
  height 30
  pad 6
  gap 5

style button
  hover-bg @active
  radius 4

style tabs
  bg @panel
  height 22
  pad 2
  gap 2

style tab
  bg @panel
  fg @muted
  active-bg @active
  active-fg @strong
  hover-bg @hover
  border 0
  radius 0
  pad 6
  height 21

style tab-new
  bg @panel
  fg @muted
  border 0
  radius 0
  pad 6
  height 21

style canvas
  bg @bg

